<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정보 수정"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="변경할 정보를 입력하세요"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- 이름 수정 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="이름"
            android:layout_marginBottom="28dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 차량 정보 섹션 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차량 정보"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cb_edit_compact_car"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="경차"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cb_edit_electric_car"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="전기차"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cb_edit_disabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="장애인 차량"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cb_edit_national_merit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="국가유공자 차량"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cb_edit_female_parking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="여성배려주차 이용 가능"
            android:textSize="15sp"
            android:layout_marginBottom="32dp" />

        <!-- 저장 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="저장"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_edit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="취소"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
